rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — only the owner can read/write their own doc
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Exhibitor profiles — owner can write; any authenticated user can read
    match /exhibitors/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Product details — same as exhibitors (doc ID == exhibitorId == userId)
    match /productDetails/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Halls — any authenticated user can read; only admin writes (via seed script / admin app)
    match /halls/{hallId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Stalls — any authenticated user can read; only auth users can write
    match /stalls/{stallId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Bookings — exhibitor can create/read their own; admin can read/update all
    match /bookings/{bookingId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null &&
                  (request.auth.uid == resource.data.exhibitorId || request.auth != null);
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Payments — any authenticated user can read/write (admin-managed)
    match /payments/{paymentId} {
      allow read, write: if request.auth != null;
    }

    // Discounts — managed by authenticated admin panel users
    match /discounts/{discountId} {
      allow read, write: if request.auth != null;
    }

    // Notifications — read/write for authenticated users
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }
  }
}